/* ==========================================================================
   Tidy Studio & Web Management Console Stylesheet
   Powered by Qahera UI Kit — New Cairo (Cyber-Obsidian & High-Tech Minimalist)
   Stack: Vanilla CSS, Logical Properties, Alexandria & Cairo Google Fonts
   ========================================================================== */

@import "qahera.css";
@import "qahera-themes.css";

/* ----------------- Design Tokens & Root Variables ----------------- */
:root {
  /* Surface Layers (Deep Cyber-Obsidian Palette mapped to Qahera Tokens) */
  --bg-darkest: var(--qhr-color-bg, #07090e);
  --bg-base: #060911;
  --bg-surface: var(--qhr-color-surface, #0d121d);
  --bg-surface-elevated: var(--qhr-color-surface-elevated, #141b2b);
  --bg-surface-glass: rgba(13, 18, 29, 0.85);
  --bg-card: rgba(13, 18, 29, 0.76);
  --bg-card-hover: rgba(20, 27, 43, 0.92);
  --bg-hover: rgba(255, 255, 255, 0.05);

  /* Borders & Dividers */
  --border-subtle: var(--qhr-border-subtle, rgba(56, 189, 248, 0.08));
  --border-light: rgba(255, 255, 255, 0.12);
  --border-focus: var(--qhr-color-primary, #0284c7);
  --border-glow: rgba(56, 189, 248, 0.3);

  /* High-Contrast Typography Hierarchy (Qahera Canon: Alexandria + Cairo) */
  --text-primary: var(--qhr-color-text-primary, #f0f4fc);
  --text-secondary: var(--qhr-color-text-secondary, #94a3b8);
  --text-muted: var(--qhr-color-text-muted, #64748b);
  --text-dim: #475569;

  /* Saturated Cyber Accents */
  --accent-cyan: var(--qhr-color-accent, #38bdf8);
  --accent-cyan-hover: #0284c7;
  --accent-cyan-glow: rgba(56, 189, 248, 0.2);
  --accent-purple: #8b5cf6;
  --accent-purple-glow: rgba(139, 92, 246, 0.2);
  --accent-green: #10b981;
  --accent-green-glow: rgba(16, 185, 129, 0.2);
  --accent-yellow: #f59e0b;
  --accent-yellow-glow: rgba(245, 158, 11, 0.2);
  --accent-red: #f43f5e;
  --accent-red-glow: rgba(244, 63, 94, 0.2);

  /* Geometry & Radius */
  --radius-xs: 5px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-pill: 9999px;

  /* Shadows & Elevations */
  --shadow-sm: 0 3px 10px rgba(0, 0, 0, 0.45);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.6);
  --shadow-lg: 0 16px 42px rgba(0, 0, 0, 0.75);
  --shadow-glow-cyan: 0 0 28px rgba(56, 189, 248, 0.28);
  --shadow-glow-purple: 0 0 28px rgba(139, 92, 246, 0.28);

  /* Typography */
  --font-heading: 'Alexandria', 'Cairo', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Cairo', 'Alexandria', 'Plus Jakarta Sans', system-ui, sans-serif;
  --font-arabic: 'Cairo', 'Alexandria', system-ui, sans-serif;
  --font-sans: 'Plus Jakarta Sans', 'Cairo', sans-serif;
  --font-mono: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
}

/* ==========================================================================
   Qahera UI Kit — Custom Developer Theme Preset
   Theme Name: tidy (tidy-cairo)
   School/Base: High-Tech Minimalist & Cyan Cyber Glass
   Provenance: Derived from Qahera القاهرة الجديدة (new-cairo)
   Mode: Day Mode (الوضع النهاري)
   ========================================================================== */

[data-theme="tidy-cairo"][data-mode="light"],
[data-mode="light"],
body[data-mode="light"] {
  /* Surfaces & Backgrounds */
  --qhr-surface-base: #F0F5FA;
  --qhr-surface-elevated: #FFFFFF;
  --qhr-surface-card: #FFFFFF;
  --qhr-surface-page: #F0F5FA;
  --qhr-surface-muted: #E2ECF6;

  /* Content & Typography Tones */
  --qhr-content-primary: #0B1320;
  --qhr-content-secondary: #334155;
  --qhr-text-primary: #0B1320;
  --qhr-text-secondary: #334155;

  /* Borders & Dividers */
  --qhr-border-subtle: #CBD9E7;
  --qhr-border-strong: #CBD9E7;
  --qhr-color-border: #CBD9E7;
  --qhr-border-width: 1px;

  /* Brand Colors & Actions */
  --qhr-color-primary: #0284C7;
  --qhr-color-primary-bg: #0284C7;
  --qhr-color-primary-fg: #FFFFFF;
  --qhr-button-primary-background: #0284C7;
  --qhr-button-primary-foreground: #FFFFFF;
  --qhr-color-secondary: #E2ECF6;
  --qhr-color-accent: #0EA5E9;
  --qhr-color-accent-fg: #FFFFFF;

  /* Architectural Radii Matrix */
  --qhr-radius-box: 12px;
  --qhr-radius-field: 4px;
  --qhr-radius-selector: 4px;
  --qhr-radius-xl: 12px;
  --qhr-radius-lg: 12px;
  --qhr-radius-md: 4px;
  --qhr-radius-sm: 4px;

  /* Token Bridges */
  --bg-darkest: var(--qhr-surface-page);
  --bg-base: var(--qhr-surface-base);
  --bg-surface: var(--qhr-surface-elevated);
  --bg-surface-elevated: var(--qhr-surface-elevated);
  --bg-surface-glass: rgba(255, 255, 255, 0.94);
  --bg-card: var(--qhr-surface-card);
  --bg-card-hover: var(--qhr-surface-muted);
  --bg-hover: rgba(2, 132, 199, 0.06);

  --border-subtle: var(--qhr-border-subtle);
  --border-light: var(--qhr-border-strong);
  --border-focus: var(--qhr-color-primary);

  --text-primary: var(--qhr-content-primary);
  --text-secondary: var(--qhr-content-secondary);
  --text-muted: #64748b;
  --text-dim: #94a3b8;

  --accent-cyan: var(--qhr-color-primary);
  --accent-cyan-hover: #0369a1;

  --shadow-sm: 0 1px 3px rgba(11, 19, 32, 0.05);
  --shadow-md: 0 4px 12px rgba(11, 19, 32, 0.07);
  --shadow-lg: 0 10px 28px rgba(11, 19, 32, 0.09);
}

/* Light Mode Specific Component Polish */
[data-mode="light"] .app-layout {
  background: var(--qhr-surface-page) !important;
}

[data-mode="light"] .sidebar {
  background-color: #ffffff !important;
  border-inline-end: 1px solid var(--qhr-border-subtle) !important;
}

[data-mode="light"] .top-bar {
  background-color: rgba(255, 255, 255, 0.95) !important;
  border-bottom: 1px solid var(--qhr-border-subtle) !important;
}

[data-mode="light"] .global-search-wrap {
  background: #ffffff !important;
  border: 1px solid var(--qhr-border-subtle) !important;
}

[data-mode="light"] .panel,
[data-mode="light"] .stat-card,
[data-mode="light"] .memory-card,
[data-mode="light"] .task-card,
[data-mode="light"] .snippet-card,
[data-mode="light"] .journal-card,
[data-mode="light"] .subagent-card,
[data-mode="light"] .table-container,
[data-mode="light"] .modal-card,
[data-mode="light"] .modal-dialog {
  background: #ffffff !important;
  border: 1px solid var(--qhr-border-subtle) !important;
  box-shadow: var(--shadow-sm) !important;
}

[data-mode="light"] .stat-card::before {
  display: none !important;
}

[data-mode="light"] .brand-text h2,
[data-mode="light"] .section-header h1,
[data-mode="light"] .stat-value,
[data-mode="light"] .panel-header h3,
[data-mode="light"] h1,
[data-mode="light"] h2,
[data-mode="light"] h3,
[data-mode="light"] h4 {
  color: var(--qhr-content-primary) !important;
}

[data-mode="light"] .section-kicker {
  color: var(--qhr-color-primary) !important;
  font-weight: 800 !important;
}

[data-mode="light"] .kicker-dot {
  background: var(--qhr-color-primary) !important;
  box-shadow: none !important;
}

[data-mode="light"] .section-header {
  border-bottom: 1px solid var(--qhr-border-subtle) !important;
}

[data-mode="light"] .subtitle {
  color: var(--qhr-content-secondary) !important;
}

[data-mode="light"] .stat-label {
  color: var(--qhr-content-secondary) !important;
}

[data-mode="light"] .nav-item {
  color: #334155;
}

[data-mode="light"] .nav-item:hover {
  background-color: var(--qhr-surface-muted) !important;
  color: #0B1320 !important;
}

[data-mode="light"] .nav-item.active {
  background: var(--qhr-surface-muted) !important;
  color: var(--qhr-color-primary) !important;
  font-weight: 700 !important;
  border-inline-start-color: var(--qhr-color-primary) !important;
}

[data-mode="light"] .nav-item.active .nav-icon {
  background: rgba(2, 132, 199, 0.12) !important;
  color: var(--qhr-color-primary) !important;
  border-color: rgba(2, 132, 199, 0.3) !important;
}

[data-mode="light"] .btn-secondary,
[data-mode="light"] .btn-lang-toggle,
[data-mode="light"] .btn-theme-toggle {
  background: var(--qhr-surface-muted) !important;
  border: 1px solid var(--qhr-border-subtle) !important;
  color: var(--qhr-content-secondary) !important;
}

[data-mode="light"] .btn-secondary:hover,
[data-mode="light"] .btn-lang-toggle:hover,
[data-mode="light"] .btn-theme-toggle:hover {
  background: #d0e0f0 !important;
  color: var(--qhr-content-primary) !important;
}

[data-mode="light"] .workspace-select {
  background: var(--qhr-surface-muted) !important;
  border: 1px solid var(--qhr-border-subtle) !important;
  color: var(--qhr-content-primary) !important;
}

[data-mode="light"] .data-table th {
  background: #F0F5FA !important;
  color: #334155 !important;
  border-bottom: 1px solid #CBD9E7 !important;
}

[data-mode="light"] .data-table td {
  color: #0B1320 !important;
  border-bottom: 1px solid #CBD9E7 !important;
}

/* Headings Typography */
h1, h2, h3, h4, .brand-text h2, .section-header h1 {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  letter-spacing: -0.02em;
}

/* RTL Specific Typography & Layout Overrides */
html[dir="rtl"],
[dir="rtl"] {
  font-family: var(--font-body);
  letter-spacing: normal !important;
}

/* Qahera SVG Icon System (Canonical Zero-Emoji Standard) */
.qhr-icon {
  width: 18px;
  height: 18px;
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.qhr-icon--xs { width: 12px; height: 12px; }
.qhr-icon--sm { width: 15px; height: 15px; }
.qhr-icon--md { width: 18px; height: 18px; }
.qhr-icon--lg { width: 22px; height: 22px; }
.qhr-icon--xl { width: 28px; height: 28px; }

.qhr-icon--danger { color: var(--accent-red); }
.qhr-icon--warning { color: var(--accent-yellow); }
.qhr-icon--info { color: var(--accent-cyan); }
.qhr-icon--success { color: var(--accent-green); }

/* Reset & Global */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button, input, select, textarea {
  font-family: inherit;
}

.nav-item, .nav-label, .sidebar-nav button {
  font-family: var(--font-body) !important;
}

body {
  background-color: var(--bg-darkest);
  color: var(--text-primary);
  font-family: var(--font-body);
  font-size: 13.5px;
  line-height: 1.55;
  overflow: hidden;
  height: 100vh;
  width: 100vw;
  user-select: none;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-pill);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--accent-cyan);
}

/* App Layout Structure with Ambient Mesh Glows */
.app-layout {
  display: flex;
  height: 100vh;
  width: 100vw;
  background: radial-gradient(circle at 15% 15%, rgba(0, 229, 255, 0.04) 0%, transparent 45%),
              radial-gradient(circle at 85% 85%, rgba(139, 92, 246, 0.05) 0%, transparent 55%),
              radial-gradient(circle at 50% 50%, rgba(16, 185, 129, 0.02) 0%, transparent 60%),
              var(--bg-base);
}

/* ----------------- Sidebar (Direction Agnostic) ----------------- */
.sidebar {
  width: 275px;
  background-color: rgba(3, 5, 9, 0.96);
  border-inline-end: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  padding: 20px 14px;
  gap: 14px;
  flex-shrink: 0;
  z-index: 20;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 6px 8px 6px;
}

.brand-logo {
  font-size: 20px;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(0, 229, 255, 0.22) 0%, rgba(139, 92, 246, 0.28) 100%);
  border: 1px solid rgba(0, 229, 255, 0.45);
  border-radius: var(--radius-md);
  box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
  flex-shrink: 0;
}

.brand-text h2 {
  font-size: 16.5px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
  letter-spacing: -0.3px;
}

.version-pill {
  font-size: 10px;
  font-family: var(--font-mono);
  background: rgba(16, 185, 129, 0.12);
  color: var(--accent-green);
  border: 1px solid rgba(16, 185, 129, 0.35);
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-weight: 700;
  display: inline-block;
  margin-top: 3px;
  letter-spacing: 0.4px;
}

/* Workspace Badge in Sidebar */
.workspace-badge {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 14px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%), var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  backdrop-filter: blur(10px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  transition: border-color 0.2s;
}

.workspace-badge:hover {
  border-color: rgba(0, 229, 255, 0.25);
}

.badge-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--accent-green);
  box-shadow: 0 0 10px var(--accent-green);
  animation: pulse-dot 2.2s infinite;
  flex-shrink: 0;
}

@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.25); opacity: 0.65; }
}

.badge-info {
  display: flex;
  flex-direction: column;
}

.badge-label {
  font-size: 9.5px;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  color: var(--text-muted);
  font-weight: 700;
  font-family: var(--font-mono);
}

.badge-name {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 1px;
}

/* Sidebar Navigation Items */
.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  overflow-y: auto;
  padding-inline-end: 2px;
}

.nav-section-title {
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 1.4px;
  color: rgba(148, 163, 184, 0.55);
  padding: 14px 12px 5px 12px;
  text-transform: uppercase;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  background: transparent;
  border: none;
  border-inline-start: 3px solid transparent;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  text-align: start;
  transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  width: 100%;
}

.nav-icon {
  font-size: 14px;
  width: 28px;
  height: 28px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 7px;
  flex-shrink: 0;
  transition: all 0.18s ease;
}

.nav-item:hover {
  background-color: rgba(255, 255, 255, 0.045);
  color: var(--text-primary);
  transform: translateX(2px);
}

[dir="rtl"] .nav-item:hover {
  transform: translateX(-2px);
}

.nav-item.active {
  background: linear-gradient(to inline-end, rgba(0, 229, 255, 0.14) 0%, rgba(139, 92, 246, 0.04) 100%);
  color: var(--text-primary);
  font-weight: 700;
  border-inline-start-color: var(--accent-cyan);
  box-shadow: 0 2px 12px rgba(0, 229, 255, 0.08);
}

.nav-item.active .nav-icon {
  background: rgba(0, 229, 255, 0.18);
  border-color: rgba(0, 229, 255, 0.4);
  color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.22);
}

.sidebar-footer {
  padding-top: 14px;
  border-top: 1px solid var(--border-subtle);
}

.storage-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.status-indicator {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-indicator.online {
  background-color: var(--accent-green);
  box-shadow: 0 0 8px var(--accent-green);
}

/* ----------------- Main Content & Header ----------------- */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: transparent;
}

/* Top Bar (3-Zone Balanced Layout) */
.top-bar {
  height: 68px;
  border-bottom: 1px solid var(--border-subtle);
  background-color: rgba(6, 9, 17, 0.86);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  gap: 16px;
  z-index: 10;
}

.top-bar-start {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.workspace-pill-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-pill);
  font-size: 11.5px;
  backdrop-filter: blur(8px);
}

.chip-pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--accent-green);
  box-shadow: 0 0 8px var(--accent-green);
  animation: pulse-dot 2.2s infinite;
  flex-shrink: 0;
}

.chip-kicker {
  font-size: 9.5px;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--text-muted);
  letter-spacing: 0.8px;
}

.chip-slash {
  color: var(--border-light);
  font-size: 11px;
}

.chip-label {
  font-weight: 600;
  color: var(--text-primary);
  font-size: 12px;
}

.top-bar-center {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 500px;
}

.global-search-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(14, 20, 36, 0.72);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 8px 14px;
  width: 100%;
  transition: all 0.2s ease;
  backdrop-filter: blur(12px);
}

.global-search-wrap:focus-within {
  border-color: var(--accent-cyan);
  box-shadow: 0 0 0 3px rgba(0, 229, 255, 0.15), var(--shadow-sm);
  background: rgba(18, 26, 46, 0.92);
}

.global-search-wrap input {
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-size: 13px;
  width: 100%;
  outline: none;
  font-family: inherit;
}

.global-search-wrap input::placeholder {
  color: var(--text-muted);
}

.search-kbd-hint kbd {
  font-family: var(--font-mono);
  font-size: 11px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-subtle);
  color: var(--text-muted);
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.select-container {
  display: inline-flex;
}

.workspace-select {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  font-weight: 500;
  cursor: pointer;
  outline: none;
  font-family: inherit;
  transition: border-color 0.2s;
}

.workspace-select:hover {
  border-color: var(--border-light);
}

.btn-lang-toggle {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  padding: 8px 14px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  font-family: inherit;
}

.btn-lang-toggle:hover {
  border-color: var(--accent-cyan);
  background: var(--bg-surface-elevated);
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.15);
}

.btn-theme-toggle {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.btn-theme-toggle:hover {
  border-color: var(--accent-cyan);
  background: var(--bg-surface-elevated);
  box-shadow: 0 0 12px rgba(0, 229, 255, 0.15);
}

/* Buttons */
.btn {
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  border: none;
  font-family: inherit;
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent-cyan) 0%, #00b4d8 100%);
  color: #030509;
  font-weight: 700;
  box-shadow: 0 2px 10px rgba(0, 229, 255, 0.25);
}

.btn-primary:hover {
  background: linear-gradient(135deg, #33ebff 0%, #00c9f0 100%);
  box-shadow: 0 4px 22px rgba(0, 229, 255, 0.45);
  transform: translateY(-1px);
}

.btn-secondary {
  background-color: var(--bg-surface-elevated);
  color: var(--text-primary);
  border: 1px solid var(--border-subtle);
}

.btn-secondary:hover {
  background-color: var(--bg-hover);
  border-color: var(--border-light);
  transform: translateY(-1px);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
}

.btn-outline:hover {
  border-color: var(--accent-cyan);
  color: var(--text-primary);
  background: rgba(0, 229, 255, 0.06);
}

.btn-sm {
  padding: 6px 14px;
  font-size: 12px;
  border-radius: var(--radius-sm);
}

.link-btn {
  background: transparent;
  border: none;
  color: var(--accent-cyan);
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: all 0.18s ease;
  font-family: inherit;
}

.link-btn:hover {
  color: #33ebff;
  transform: translateX(-2px);
}

[dir="ltr"] .link-btn:hover {
  transform: translateX(2px);
}

/* ----------------- Content Body & Tab Panes ----------------- */
.content-body {
  flex: 1;
  overflow-y: auto;
  padding: 30px;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
  animation: paneFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes paneFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24px;
  gap: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.section-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
  color: var(--accent-cyan);
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.kicker-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-cyan);
  box-shadow: 0 0 8px var(--accent-cyan);
}

.section-header h1 {
  font-size: 26px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.25;
  letter-spacing: -0.4px;
}

[dir="rtl"] .section-header h1 {
  font-size: 27px;
  font-weight: 800;
}

.subtitle {
  color: var(--text-secondary);
  font-size: 13.5px;
  margin-top: 4px;
  line-height: 1.5;
}

/* ----------------- Stats Cards Grid (Rigid 4-Column Layout) ----------------- */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 28px;
}

@media (max-width: 1060px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 580px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
}

.stat-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.15) 50%, transparent 100%);
  opacity: 0.8;
}

.stat-card:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 229, 255, 0.3);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55), 0 0 20px rgba(0, 229, 255, 0.08);
  background: var(--bg-card-hover);
}

.stat-icon {
  width: 50px;
  height: 50px;
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23px;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.stat-card:hover .stat-icon {
  transform: scale(1.06);
}

.stat-icon.cyan { background-color: var(--accent-cyan-glow); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.35); }
.stat-icon.yellow { background-color: var(--accent-yellow-glow); color: var(--accent-yellow); border: 1px solid rgba(245, 158, 11, 0.35); }
.stat-icon.purple { background-color: var(--accent-purple-glow); color: var(--accent-purple); border: 1px solid rgba(139, 92, 246, 0.35); }
.stat-icon.green { background-color: var(--accent-green-glow); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.35); }

.stat-details {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.stat-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 2px;
}

.stat-label {
  font-size: 11px;
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-chip {
  font-size: 9px;
  font-weight: 700;
  font-family: var(--font-mono);
  padding: 1px 6px;
  border-radius: var(--radius-pill);
  letter-spacing: 0.4px;
}
.stat-chip.cyan { background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.25); }
.stat-chip.yellow { background: rgba(245, 158, 11, 0.12); color: var(--accent-yellow); border: 1px solid rgba(245, 158, 11, 0.25); }
.stat-chip.purple { background: rgba(139, 92, 246, 0.12); color: var(--accent-purple); border: 1px solid rgba(139, 92, 246, 0.25); }
.stat-chip.green { background: rgba(16, 185, 129, 0.12); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.25); }

.stat-value {
  font-size: 26px;
  font-weight: 800;
  color: var(--text-primary);
  margin-top: 1px;
  letter-spacing: -0.5px;
  font-family: var(--font-mono);
  line-height: 1.15;
}

/* ----------------- Panels & Grids ----------------- */
.two-column-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

@media (max-width: 1080px) {
  .two-column-grid {
    grid-template-columns: 1fr;
  }
}

.panel {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: border-color 0.2s;
}

.panel:hover {
  border-color: var(--border-light);
}

.panel-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.02);
}

.panel-title-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
}

.panel-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.panel-dot.cyan { background: var(--accent-cyan); box-shadow: 0 0 8px var(--accent-cyan); }
.panel-dot.amber { background: var(--accent-yellow); box-shadow: 0 0 8px var(--accent-yellow); }

.panel-header h3 {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text-primary);
}

.panel-body {
  padding: 18px 20px;
  flex: 1;
}

/* ----------------- Overview List Items & Bidi Correctness ----------------- */
.overview-item {
  padding: 13px 15px;
  margin-bottom: 10px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.overview-item:hover {
  background: rgba(255, 255, 255, 0.045);
  border-color: rgba(0, 229, 255, 0.2);
  transform: translateY(-1px);
}

.overview-item:last-child {
  margin-bottom: 0;
}

.overview-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  gap: 8px;
}

.overview-item-body {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-primary);
  unicode-bidi: plaintext;
  text-align: start;
}

/* Priority & Category Badges */
.badge-tag {
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
  padding: 2px 7px;
  border-radius: var(--radius-xs);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: inline-block;
}

.badge-tag.fact { background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.3); }
.badge-tag.decision { background: rgba(139, 92, 246, 0.12); color: var(--accent-purple); border: 1px solid rgba(139, 92, 246, 0.3); }
.badge-tag.pattern { background: rgba(16, 185, 129, 0.12); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.3); }
.badge-tag.rule { background: rgba(245, 158, 11, 0.12); color: var(--accent-yellow); border: 1px solid rgba(245, 158, 11, 0.3); }
.badge-tag.task { background: rgba(239, 68, 68, 0.12); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.3); }

.badge-priority {
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
  padding: 2px 7px;
  border-radius: var(--radius-xs);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge-priority.urgent { background: rgba(239, 68, 68, 0.18); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.4); }
.badge-priority.high { background: rgba(245, 158, 11, 0.18); color: var(--accent-yellow); border: 1px solid rgba(245, 158, 11, 0.4); }
.badge-priority.medium { background: rgba(0, 229, 255, 0.15); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.3); }
.badge-priority.low { background: rgba(100, 116, 139, 0.15); color: var(--text-muted); border: 1px solid rgba(100, 116, 139, 0.3); }

.badge-domain {
  font-size: 10px;
  font-family: var(--font-mono);
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.04);
  padding: 1px 6px;
  border-radius: var(--radius-xs);
}

/* ----------------- Filter Bars & Form Controls ----------------- */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.filter-group {
  display: flex;
  align-items: center;
  gap: 8px;
}

.filter-group label {
  font-size: 12px;
  color: var(--text-secondary);
  font-weight: 500;
}

.form-select,
.form-input,
.form-textarea {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-family: inherit;
  font-size: 13px;
  padding: 8px 12px;
  outline: none;
  transition: all 0.18s ease;
}

.form-select:focus,
.form-input:focus,
.form-textarea:focus {
  border-color: var(--accent-cyan);
  box-shadow: 0 0 0 2px rgba(0, 229, 255, 0.15);
  background: var(--bg-surface-elevated);
}

.search-input-wrap {
  flex: 1;
  min-width: 200px;
}

.search-input-wrap .form-input {
  width: 100%;
}

/* ----------------- Memory Cards Grid ----------------- */
.memory-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 18px;
}

.memory-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  backdrop-filter: blur(12px);
  transition: all 0.2s ease;
}

.memory-card:hover {
  border-color: var(--border-light);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.memory-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.memory-content {
  font-size: 13px;
  line-height: 1.65;
  color: var(--text-primary);
  flex: 1;
  white-space: pre-wrap;
  unicode-bidi: plaintext;
  text-align: start;
}

.memory-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
  border-top: 1px solid var(--border-subtle);
  padding-top: 10px;
}

/* ----------------- Tasks Board (Kanban Columns) ----------------- */
.tasks-container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  align-items: start;
}

@media (max-width: 1200px) {
  .tasks-container {
    grid-template-columns: repeat(2, 1fr);
  }
}

.task-column {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 480px;
}

.column-header {
  padding: 12px 16px;
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  background: var(--bg-surface-elevated);
}

.count-badge {
  background: rgba(255, 255, 255, 0.1);
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-family: var(--font-mono);
}

.task-cards-list {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
  overflow-y: auto;
}

.task-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: all 0.15s ease;
}

.task-card:hover {
  border-color: var(--border-light);
  transform: translateY(-1px);
}

.task-card-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  unicode-bidi: plaintext;
  text-align: start;
}

.task-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: var(--text-muted);
}

/* ----------------- Subagents Hub & Skills ----------------- */
.subagents-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 18px;
  margin-bottom: 26px;
}

.subagent-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  backdrop-filter: blur(12px);
  transition: all 0.2s ease;
}

.subagent-card:hover {
  border-color: rgba(139, 92, 246, 0.35);
  box-shadow: var(--shadow-md);
}

.subagent-card-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.subagent-avatar {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: var(--accent-purple-glow);
  color: var(--accent-purple);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  border: 1px solid rgba(139, 92, 246, 0.3);
}

.subagent-info h4 {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

.subagent-info span {
  font-size: 11px;
  color: var(--text-muted);
}

.subagent-desc {
  font-size: 12.5px;
  color: var(--text-secondary);
  line-height: 1.55;
  unicode-bidi: plaintext;
  text-align: start;
}

.subagent-runner-panel {
  margin-top: 24px;
}

.subagent-result-box {
  margin-top: 16px;
  background: var(--bg-darkest);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 14px;
}

.subagent-result-box pre {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.6;
  color: #e2e8f0;
  white-space: pre-wrap;
  max-height: 320px;
  overflow-y: auto;
}

/* ----------------- Code Snippets ----------------- */
.snippets-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 18px;
}

.snippet-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  backdrop-filter: blur(12px);
}

.snippet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.snippet-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

.snippet-lang-tag {
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  font-size: 10.5px;
  font-family: var(--font-mono);
  background: rgba(0, 229, 255, 0.12);
  color: var(--accent-cyan);
  border: 1px solid rgba(0, 229, 255, 0.25);
}

.snippet-code-box {
  background: var(--bg-darkest);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 12px;
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 1.55;
  color: #e2e8f0;
  overflow-x: auto;
  max-height: 160px;
  white-space: pre-wrap;
  direction: ltr !important;
  text-align: left !important;
}

.snippet-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin-top: auto;
}

/* ----------------- Daily Journal ----------------- */
.journal-timeline {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 860px;
}

.journal-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  backdrop-filter: blur(12px);
}

.journal-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.journal-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
}

.journal-date {
  font-size: 11.5px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.journal-entry-body {
  color: var(--text-primary);
  font-size: 13.5px;
  line-height: 1.65;
  white-space: pre-wrap;
  unicode-bidi: plaintext;
  text-align: start;
}

/* ----------------- Vault & Secret Keys ----------------- */
.vault-secret-val {
  font-family: var(--font-mono);
  color: var(--accent-cyan);
  background: var(--bg-darkest);
  padding: 4px 10px;
  border-radius: var(--radius-xs);
  font-size: 12px;
  display: inline-block;
  min-width: 140px;
  letter-spacing: 1px;
  border: 1px solid var(--border-subtle);
}

.vault-actions-cell {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-icon {
  background: transparent;
  border: 1px solid var(--border-subtle);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  padding: 5px 9px;
  cursor: pointer;
  font-size: 13px;
  transition: all 0.18s ease;
}

.btn-icon:hover {
  color: var(--text-primary);
  border-color: var(--accent-cyan);
  background: var(--bg-hover);
}

.btn-icon.delete:hover {
  border-color: var(--accent-red);
  color: var(--accent-red);
  background: rgba(239, 68, 68, 0.1);
}

/* ----------------- Database Maintenance & Settings ----------------- */
.diagnostic-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid var(--border-subtle);
  font-size: 13px;
}

.diagnostic-row:last-child {
  border-bottom: none;
}

.diag-label {
  color: var(--text-secondary);
}

.diag-value {
  color: var(--text-primary);
  font-weight: 600;
}

.diag-value.mono {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent-cyan);
}

.db-actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.db-action-card {
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
}

.db-action-info h4 {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.db-action-info p {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.5;
}

.db-action-result {
  padding: 12px 16px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-family: var(--font-mono);
  background: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  color: var(--accent-green);
}

/* ----------------- Office Suite Tables (Direction Agnostic) ----------------- */
.table-container {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow-x: auto;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: start;
  font-size: 13px;
}

.data-table th {
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.02);
  color: var(--text-secondary);
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  border-bottom: 1px solid var(--border-subtle);
  text-align: start;
}

.data-table td {
  padding: 15px 18px;
  border-bottom: 1px solid var(--border-subtle);
  vertical-align: middle;
  text-align: start;
}

.data-table tr:last-child td {
  border-bottom: none;
}

.data-table tr:hover td {
  background: rgba(255, 255, 255, 0.03);
}

/* Status Badges */
.badge {
  display: inline-flex;
  align-items: center;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: var(--radius-pill);
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.badge.lead { background: rgba(0, 229, 255, 0.12); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.3); }
.badge.prospect { background: rgba(139, 92, 246, 0.12); color: var(--accent-purple); border: 1px solid rgba(139, 92, 246, 0.3); }
.badge.active { background: rgba(16, 185, 129, 0.12); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.3); }
.badge.inactive, .badge.archived { background: rgba(100, 116, 139, 0.15); color: var(--text-muted); border: 1px solid rgba(100, 116, 139, 0.3); }
.badge.paid { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); border: 1px solid rgba(16, 185, 129, 0.4); }
.badge.pending { background: rgba(245, 158, 11, 0.15); color: var(--accent-yellow); border: 1px solid rgba(245, 158, 11, 0.4); }
.badge.overdue { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.4); }
.badge.partially_paid { background: rgba(0, 229, 255, 0.15); color: var(--accent-cyan); border: 1px solid rgba(0, 229, 255, 0.3); }
.badge.draft { background: rgba(100, 116, 139, 0.15); color: var(--text-muted); border: 1px solid rgba(100, 116, 139, 0.3); }
.badge.cancelled { background: rgba(239, 68, 68, 0.12); color: var(--accent-red); border: 1px solid rgba(239, 68, 68, 0.3); }

/* ----------------- Modals ----------------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 7, 12, 0.75);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-backdrop.active,
.modal-backdrop.open {
  display: flex !important;
}

.modal-card,
.modal-dialog {
  background: var(--bg-surface);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 540px;
  box-shadow: var(--shadow-lg), 0 0 30px rgba(0, 229, 255, 0.1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: modalPop 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.modal-card.modal-lg {
  max-width: 820px;
}

@keyframes modalPop {
  from { opacity: 0; transform: scale(0.96) translateY(8px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-header {
  padding: 16px 22px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.02);
}

.modal-header h3 {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 20px;
  cursor: pointer;
  padding: 4px 8px;
  line-height: 1;
  transition: color 0.15s;
}

.modal-close:hover {
  color: var(--text-primary);
}

.modal-body {
  padding: 22px;
  overflow-y: auto;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.modal-footer {
  padding: 16px 22px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  background: rgba(255, 255, 255, 0.015);
}

/* Form Elements inside Modals */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-secondary);
}

.form-row {
  display: flex;
  gap: 14px;
}

.form-row .form-group {
  flex: 1;
}

.skeleton-loader {
  color: var(--text-muted);
  font-size: 13px;
  padding: 16px 0;
  text-align: center;
  font-style: italic;
}

/* ==========================================================================
   Split-Screen & Responsive Adaptive Architecture
   Preserves layout balance when windows are split to 50% width (~600px-850px)
   ========================================================================== */

@media (max-width: 1180px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .two-column-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 960px) {
  .top-bar-start {
    display: none !important;
  }
  .top-bar {
    padding: 0 16px;
  }
  .top-bar-center {
    max-width: none;
  }
}

@media (max-width: 860px) {
  /* Dock Sidebar to Compact Icon Rail */
  .sidebar {
    width: 68px !important;
    min-width: 68px !important;
    max-width: 68px !important;
    padding: 16px 8px !important;
    align-items: center;
  }
  .sidebar-brand {
    padding: 0;
    justify-content: center;
  }
  .brand-text,
  .workspace-selector,
  .nav-section-title,
  .sidebar-footer,
  .nav-item .nav-label {
    display: none !important;
  }
  .sidebar-nav {
    width: 100%;
    align-items: center;
    gap: 6px;
  }
  .sidebar-nav .nav-item {
    justify-content: center;
    padding: 8px 0;
    border-radius: var(--radius-md);
    border-inline-start: none !important;
    border-bottom: 2px solid transparent;
    width: 44px;
    height: 44px;
  }
  .sidebar-nav .nav-item.active {
    background: rgba(56, 189, 248, 0.15);
    border-color: var(--accent-cyan);
  }
  .nav-icon {
    margin: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  .content-area {
    padding: 20px 16px !important;
  }
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}

@media (max-width: 680px) {
  .top-bar-actions .btn span {
    display: none;
  }
  .top-bar-actions .btn {
    padding: 8px 10px;
  }
  .stats-grid {
    grid-template-columns: 1fr;
  }
  .tasks-container {
    grid-template-columns: 1fr;
  }
}
