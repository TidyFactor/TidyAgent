{
  "manifest_schema_version": "1.1.0",
  "skill_id": "tidy",
  "skill_root_anchor": "self",
  "tools": [
    {
      "name": "bootstrap_db",
      "description": "Creates ~/.tidy/tidy.db if absent (auto-migrating from ~/.tidy/tidy.db if present), applies high-performance PRAGMAs, builds 8-table relational schema with FTS5 unicode61 tokenizer and sync triggers, and seeds default Ring 0 profile.",
      "entrypoint": { "runtime": "node", "script": "scripts/db.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js init {flags}",
        "args": [
          { "name": "force", "type": "boolean", "required": false, "default": false, "flag": "--force", "description": "Drop and recreate schema on existing database." },
          { "name": "db_path", "type": "string", "required": false, "flag": "--db-path", "description": "Custom SQLite database destination path." }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/db-stats.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["init.md", "db.md"]
    },
    {
      "name": "memory_recall",
      "description": "Full-text search over memory_nodes via FTS5 BM25 ranking, scoped by context firewall and category.",
      "entrypoint": { "runtime": "node", "script": "scripts/memory.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js memory recall {query} {flags}",
        "args": [
          { "name": "query", "type": "string", "required": true, "description": "Free-text search query in Arabic or English." },
          { "name": "context", "type": "string", "required": false, "flag": "--context", "description": "Restrict to a specific context_id." },
          { "name": "category", "type": "string", "required": false, "flag": "--category", "description": "One of fact|decision|pattern|preference|task|rule." },
          { "name": "limit", "type": "number", "required": false, "default": 10, "flag": "--limit" }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/memory-recall.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["memory.md"]
    },
    {
      "name": "memory_save",
      "description": "Inserts a new memory node (fact, decision, pattern, preference, task, rule) and synchronizes the FTS5 index via SQLite triggers.",
      "entrypoint": { "runtime": "node", "script": "scripts/memory.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js memory save {content} {flags}",
        "args": [
          { "name": "content", "type": "string", "required": true, "description": "Text content of the fact or decision to store." },
          { "name": "tier", "type": "string", "required": false, "default": "session", "flag": "--tier", "description": "One of core|project|session|ephemeral." },
          { "name": "category", "type": "string", "required": false, "default": "fact", "flag": "--category" },
          { "name": "importance", "type": "number", "required": false, "default": 3, "flag": "--importance" },
          { "name": "context", "type": "string", "required": false, "flag": "--context" }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/memory-node.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["memory.md"]
    },
    {
      "name": "context_switch",
      "description": "Activates a workspace context, applies the Contextual Firewall (domain isolation), and updates Ring 1 for subsequent memory reads.",
      "entrypoint": { "runtime": "node", "script": "scripts/memory.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js context switch {context_id}",
        "args": [
          { "name": "context_id", "type": "string", "required": true, "description": "ID of the target context row." }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/context.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["context.md"]
    },
    {
      "name": "subagent_run",
      "description": "Delegates a task to one of the registered subagents (planner, coder, researcher, scribe) injecting 3-ring context.",
      "entrypoint": { "runtime": "node", "script": "scripts/subagents.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js agent run {agent_name} {task}",
        "args": [
          { "name": "agent_name", "type": "string", "required": true, "description": "Name of subagent: planner|coder|researcher|scribe." },
          { "name": "task", "type": "string", "required": true, "description": "The specific instruction or task description." }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/subagent-result.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["agent.md"]
    },
    {
      "name": "task_manage",
      "description": "Manages tasks micro-app items (add, list, update, complete) stored directly in SQLite.",
      "entrypoint": { "runtime": "node", "script": "scripts/apps.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js app task {action} {args}",
        "args": [
          { "name": "action", "type": "string", "required": true, "description": "Action: list|add|complete|delete." }
        ]
      },
      "output": { "format": "json", "channel": "stdout", "schema_ref": "references/schemas/task-item.schema.json" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["app.md"]
    },
    {
      "name": "mcp_server",
      "description": "Starts the local stdio JSON-RPC 2.0 Model Context Protocol server exposing 10 tools and 3 live dynamic resources.",
      "entrypoint": { "runtime": "node", "script": "scripts/mcp_server.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/scripts/mcp_server.js",
        "args": []
      },
      "output": { "format": "json", "channel": "stdout" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["mcp.md"]
    },
    {
      "name": "skills_manage",
      "description": "Scans, lists, and registers community skills (from TidyFactor Skills-LAB or custom folders) as sovereign first-class subagents.",
      "entrypoint": { "runtime": "node", "script": "scripts/skills-loader.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js skills {action} {target}",
        "args": [
          { "name": "action", "type": "string", "required": true, "description": "Action: scan|list|register." },
          { "name": "target", "type": "string", "required": false, "description": "Directory to scan or path to skill folder." }
        ]
      },
      "output": { "format": "json", "channel": "stdout" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["skills.md"]
    },
    {
      "name": "brief_generate",
      "description": "Synthesizes an autonomous, self-contained Markdown Task Brief for subagents by combining task goal, 3-ring context (profile, workspace, recalled memory), skill operational rules, and verification checklist.",
      "entrypoint": { "runtime": "node", "script": "scripts/brief-generator.js" },
      "invocation": {
        "cli_pattern": "node {skill_root}/bin/tidy.js brief {task_or_title}",
        "args": [
          { "name": "task_or_title", "type": "string", "required": true, "description": "Task numeric ID or raw title/instruction." }
        ]
      },
      "output": { "format": "text", "channel": "stdout" },
      "runtime_requirements": { "isolation_recommended": false, "dependencies": [] },
      "invoked_by_commands": ["skills.md", "agent.md"]
    }
  ],
  "decision_gates": [
    {
      "command": "init",
      "description": "Decisions resolved once, before the database is first bootstrapped.",
      "decisions": [
        {
          "key": "storage_path",
          "description": "Where does tidy.db live?",
          "type": "enum",
          "options": ["~/.tidy/tidy.db", ".tidyfactor/tidy.db"],
          "default": "~/.tidy/tidy.db",
          "priority": 1,
          "discovery": [
            { "source": "cli_flag", "field": "--db-path" },
            { "source": "local_file", "path": ".tidyfactor/tidy.snapshot.yaml", "field": "storage_path", "track_staleness": true }
          ],
          "persist_to": { "local": { "path": ".tidyfactor/tidy.snapshot.yaml", "field": "storage_path" } }
        },
        {
          "key": "locale",
          "description": "Default conversational locale for the assistant profile.",
          "type": "enum",
          "options": ["ar", "en"],
          "default": "ar",
          "priority": 2,
          "discovery": [
            { "source": "local_file", "path": ".tidyfactor/tidy.snapshot.yaml", "field": "locale", "track_staleness": true }
          ],
          "persist_to": { "local": { "path": ".tidyfactor/tidy.snapshot.yaml", "field": "locale" } }
        },
        {
          "key": "runtime",
          "description": "Language/runtime used for the zero-dependency SQLite engine.",
          "type": "enum",
          "options": ["node:sqlite"],
          "default": "node:sqlite",
          "priority": 3,
          "discovery": [
            { "source": "workspace_scan", "path": "package.json" }
          ],
          "persist_to": { "local": { "path": ".tidyfactor/tidy.snapshot.yaml", "field": "runtime" } }
        },
        {
          "key": "license",
          "description": "Distribution license for the tidy package.",
          "type": "enum",
          "options": ["Apache-2.0"],
          "default": "Apache-2.0",
          "priority": 4,
          "discovery": [
            { "source": "local_file", "path": "LICENSE" }
          ],
          "persist_to": { "local": { "path": ".tidyfactor/tidy.snapshot.yaml", "field": "license" } }
        }
      ]
    }
  ]
}
