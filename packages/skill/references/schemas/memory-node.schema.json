{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidyfactor.dev/schemas/tidy/memory-node.schema.json",
  "title": "Tidy Memory Node",
  "type": "object",
  "required": ["id", "tier", "category", "content"],
  "properties": {
    "id": { "type": "string" },
    "context_id": { "type": ["string", "null"] },
    "tier": { "type": "string", "enum": ["core", "project", "session", "ephemeral"] },
    "category": { "type": "string", "enum": ["fact", "decision", "pattern", "preference", "task", "rule"] },
    "content": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
    "access_count": { "type": "integer" },
    "decay_score": { "type": "number" },
    "created_at": { "type": "string" },
    "last_accessed_at": { "type": "string" }
  }
}
