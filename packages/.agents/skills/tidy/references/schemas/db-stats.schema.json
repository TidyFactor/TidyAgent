{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidyfactor.dev/schemas/tidy/db-stats.schema.json",
  "title": "Tidy DB Stats / Health Schema",
  "type": "object",
  "required": ["ok", "db_path", "tables", "wal_mode"],
  "properties": {
    "ok": { "type": "boolean" },
    "db_path": { "type": "string" },
    "tables": { "type": "integer" },
    "triggers": { "type": "integer" },
    "wal_mode": { "type": "string" },
    "size_bytes": { "type": "integer" },
    "row_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "memory_nodes_count": { "type": "integer" },
    "pruned": { "type": "integer" },
    "dry_run": { "type": "boolean" }
  }
}
