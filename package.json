{
  "name": "tidy-agent",
  "version": "1.8.0",
  "description": "Sovereign Personal Assistant Agent with persistent SQLite Memory, CLI engine, and local Stdio MCP Server",
  "main": "index.js",
  "bin": {
    "tidy": "./bin/tidy.js",
    "tidy-agent": "./bin/tidy.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node bin/tidy.js",
    "cli": "node packages/cli/bin/tidy.js",
    "desktop": "npm --prefix apps/desktop start",
    "web": "node apps/web/server.js",
    "test": "node tests/run.js",
    "mcp": "node scripts/mcp_server.js",
    "init-db": "node bin/tidy.js init",
    "validate": "python packages/skill/tools/validate_skill.py",
    "audit:skill": "node scripts/skills-validator.js packages/skill",
    "build": "node packages/skill/tools/build-skill.js",
    "check:leaks": "node tools/check-leaks.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "keywords": [
    "tidy",
    "tidyfactor",
    "agent",
    "personal-assistant",
    "sqlite",
    "mcp",
    "memory",
    "fts5",
    "sovereign"
  ],
  "author": "TidyFactor Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TidyFactor/TidyAgent.git"
  },
  "homepage": "https://github.com/TidyFactor/TidyAgent#readme",
  "bugs": {
    "url": "https://github.com/TidyFactor/TidyAgent/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "index.js",
    "bin",
    "packages",
    "scripts",
    "tools",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
