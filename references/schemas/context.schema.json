{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidyfactor.dev/schemas/tidy/context.schema.json",
  "title": "Tidy Context",
  "type": "object",
  "required": ["id", "name", "domain", "is_active"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "domain": { "type": "string", "enum": ["dev", "marketing", "personal", "ops", "general"] },
    "workspace_path": { "type": ["string", "null"] },
    "is_active": { "type": "integer", "enum": [0, 1] },
    "last_accessed_at": { "type": "string" }
  }
}
